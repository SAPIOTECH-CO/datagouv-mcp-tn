# Copy this file to .env and fill in your values
# cp .env.example .env

# ---------------------------------------------------------------------------
# Dynamic portals
# ---------------------------------------------------------------------------
# Add portals without touching code by setting PORTAL_<KEY>_API_URL.
# The <KEY> is converted to lowercase with dashes (e.g. PORTAL_MY_PORTAL_API_URL
# becomes key "my-portal").
#
# Optional overrides per portal:
#   PORTAL_<KEY>_NAME            Display name (defaults to the key)
#   PORTAL_<KEY>_CATALOG_URL     UI catalog URL (defaults to api_url with /api/3 stripped)
#   PORTAL_<KEY>_DESCRIPTION     Short description
#   PORTAL_<KEY>_REQUIRES_AUTH   true/false (default: false)
#   PORTAL_<KEY>_SSL_VERIFY      true/false (default: true). Set false for portals with SSL certificate errors
#   PORTAL_<KEY>_API_KEY         API key / token for authenticated portals
#   PORTAL_<KEY>_REQUEST_TIMEOUT HTTP timeout in seconds (default: 30)
#   PORTAL_<KEY>_REQUEST_MAX_RETRIES  Retries on transient failures (default: 2)
#   PORTAL_<KEY>_RETRY_BACKOFF_SECONDS  Base delay for exponential backoff (default: 0.5)
#   PORTAL_<KEY>_DOWNLOAD_TIMEOUT     Download timeout in seconds (default: 120)
#   PORTAL_<KEY>_MAX_DOWNLOAD_SIZE_MB  Max download size in MB (default: 50)
#
# Built-in defaults (no env needed): data-gov-tn, industrie, culture, transport, agridata

# Example: add a custom portal
# PORTAL_MY_PORTAL_API_URL=https://catalog.example.com/api/3
# PORTAL_MY_PORTAL_NAME=My Custom Portal
# PORTAL_MY_PORTAL_CATALOG_URL=https://catalog.example.com
# PORTAL_MY_PORTAL_API_KEY=my-secret-key

# Default portal key (must match one of the built-in keys or a PORTAL_<KEY>_API_URL key)
DEFAULT_PORTAL_KEY=agridata

# ---------------------------------------------------------------------------
# MCP server transport
# ---------------------------------------------------------------------------
# stdio | http | sse
# - stdio: local MCP clients launch the server as a subprocess (default)
# - http:  streamable HTTP, recommended for production (endpoint /mcp)
# - sse:   legacy Server-Sent Events, backward compatibility only (endpoint /sse)
FASTMCP_TRANSPORT=http

# Host and port used by the http and sse transports
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# ---------------------------------------------------------------------------
# Client / HTTP settings
# ---------------------------------------------------------------------------
# HTTP timeout in seconds for portal API requests
REQUEST_TIMEOUT=30
# Retries on transient failures (timeouts, connection errors, 429/5xx)
REQUEST_MAX_RETRIES=2
# Base delay (seconds) for exponential backoff between retries
RETRY_BACKOFF_SECONDS=0.5
# Max size (MB) for resource downloads used by the data tools
MAX_DOWNLOAD_SIZE_MB=50
# Timeout (seconds) for resource downloads
DOWNLOAD_TIMEOUT=120
# Default output language for tool messages (fr | ar | en)
DEFAULT_LANGUAGE=fr

# ---------------------------------------------------------------------------
# Generative UI (opt-in)
# ---------------------------------------------------------------------------
# Registers generate_prefab_ui / search_prefab_components: the LLM composes
# Prefab views at runtime, executed in a Pyodide sandbox. Requires Deno on
# the host (auto-installed on first use). Off by default.
ENABLE_GENERATIVE_UI=false

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Enable strict input validation for all tool arguments (FastMCP native)
STRICT_INPUT_VALIDATION=true

# Rate limiting (SlidingWindowRateLimitingMiddleware)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# CORS configuration
CORS_ENABLED=true
# JSON array of allowed origins (use ["*"] for all)
CORS_ALLOWED_ORIGINS=["*"]
# JSON array of allowed HTTP methods
CORS_ALLOWED_METHODS=["GET","POST","DELETE","OPTIONS"]
# JSON array of allowed headers
CORS_ALLOWED_HEADERS=["mcp-protocol-version","mcp-session-id","Authorization","Content-Type"]
# JSON array of headers exposed to the browser
CORS_EXPOSE_HEADERS=["mcp-session-id"]
# Allow credentials (cookies, auth headers) in CORS requests
CORS_ALLOW_CREDENTIALS=false
# Max age (seconds) for CORS preflight cache
CORS_MAX_AGE=600

# Host/Origin protection (DNS rebinding guard)
HOST_ORIGIN_PROTECTION=true
# JSON array of allowed Host headers (empty array = auto)
ALLOWED_HOSTS=[]
# JSON array of allowed Origin headers (empty array = auto)
ALLOWED_ORIGINS=[]

# Log sanitization (secrets + PII masking)
LOG_SANITIZATION_ENABLED=true
