# Copy this file to .env and fill in your values
# cp .env.example .env

# --- data.gouv.tn API ---
# Base URL of the Tunisian open data portal uData API
DATA_GOUV_TN_API_URL=https://data.gouv.tn/api/1
# API key / token if the portal requires authentication (leave empty if public)
DATA_GOUV_TN_API_KEY=

# --- MCP server transport ---
# stdio | http | sse
# - stdio: local MCP clients launch the server as a subprocess (default)
# - http:  streamable HTTP, recommended for production (endpoint /mcp)
# - sse:   legacy Server-Sent Events, backward compatibility only (endpoint /sse)
FASTMCP_TRANSPORT=stdio

# Host and port used by the http and sse transports
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# --- Client ---
# HTTP timeout in seconds for data.gouv.tn API requests
REQUEST_TIMEOUT=30
# Retries on transient failures (timeouts, connection errors, 429/5xx)
REQUEST_MAX_RETRIES=2
# Base delay (seconds) for exponential backoff between retries
RETRY_BACKOFF_SECONDS=0.5
# Max size (MB) for resource downloads used by the data tools
MAX_DOWNLOAD_SIZE_MB=50
# Timeout (seconds) for resource downloads
DOWNLOAD_TIMEOUT=120
# Default output language for tool messages (fr | ar | en)
DEFAULT_LANGUAGE=fr

# --- Generative UI (opt-in) ---
# Registers generate_prefab_ui / search_prefab_components: the LLM composes
# Prefab views at runtime, executed in a Pyodide sandbox. Requires Deno on
# the host (auto-installed on first use). Off by default.
ENABLE_GENERATIVE_UI=false

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Security ---
# Enable strict input validation for all tool arguments (FastMCP native)
STRICT_INPUT_VALIDATION=true

# Rate limiting (SlidingWindowRateLimitingMiddleware)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MINUTES=1

# CORS configuration
CORS_ENABLED=true
# Comma-separated list of allowed origins (or * for all)
CORS_ALLOWED_ORIGINS=*
# Comma-separated list of allowed HTTP methods
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
# Comma-separated list of allowed headers
CORS_ALLOWED_HEADERS=mcp-protocol-version,mcp-session-id,Authorization,Content-Type
# Comma-separated list of headers exposed to the browser
CORS_EXPOSE_HEADERS=mcp-session-id
# Allow credentials (cookies, auth headers) in CORS requests
CORS_ALLOW_CREDENTIALS=false
# Max age (seconds) for CORS preflight cache
CORS_MAX_AGE=600

# Host/Origin protection (DNS rebinding guard)
HOST_ORIGIN_PROTECTION=true
# Comma-separated list of allowed Host headers (empty = auto)
ALLOWED_HOSTS=
# Comma-separated list of allowed Origin headers (empty = auto)
ALLOWED_ORIGINS=

# Log sanitization (secrets + PII masking)
LOG_SANITIZATION_ENABLED=true
