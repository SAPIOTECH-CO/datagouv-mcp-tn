# Copy this file to .env and fill in your values
# cp .env.example .env

# --- data.gouv.tn API ---
# Base URL of the Tunisian open data portal API
DATA_GOUV_TN_API_URL=https://data.gouv.tn/api
# API key / token if the portal requires authentication (leave empty if public)
DATA_GOUV_TN_API_KEY=

# --- MCP server ---
# Transport: stdio | http | sse
FASTMCP_TRANSPORT=stdio
FASTMCP_HOST=127.0.0.1
FASTMCP_PORT=8000

# --- Logging ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
